// Include the V5 Library
#include "vex.h"
  
// Allows for easier use of the VEX Library
using namespace vex;

double currentX = 70.6; 
double currentY = 8; //16 start //19 after
double currentD = 0;
double tempCurrentD=0;

double calcX(double degree){
  degree = 9.5*sin(degree);
  degree *= 180;
  return degree / M_PI;

}
 
double calcY(double degree){
  degree =  9.5*cos(degree);
  degree *= 180;
  return degree / M_PI;
}

void move(double x){
  Drivetrain.driveFor(forward, 200, inches,true);
}
void move(double x, int y){
  Drivetrain.driveFor(forward, 200, inches,false);
}

void trn(double x){
  Drivetrain.turnFor(left, x,degrees,true);
}

void trn(double x,int y){
  Drivetrain.turnFor(left, x,degrees,false);
}

void turnTo(double x){
  double degree = currentD - x;
  if(fabs(degree)-180>0){
    if(degree < 0){
      degree+=180;
    }
    else {
      degree-=180;
    }
  }
  trn(degree);
}

void turnTo(double x,int y){
  double degree = currentD - x;
  if(fabs(degree)-180>0){
    if(degree < 0){
      degree+=180;
    }
    else {
      degree-=180;
    }
  }
  trn(degree);
}


void cordMove(double x, double y){
  //solve c and distance of movement
  double a = fabs(currentX-x);
  double b = fabs(currentY-y);
  double c = sqrt(a * a + b * b);

  double degree = acos((b*b-a*a-c*c)/(-2*a*c));

  //find the quandrient and direction where it needs to go
  if(currentX-x > 0){
    if(currentY-y > 0){
      a += calcX(degree);
      b += calcY(degree);
      degree += 0;
    }
    else{
      a += calcX(degree);
      b -= calcY(degree);
      degree += 270;
    }

  }
  else{
    if(currentY-y > 0){
      a -= calcX(degree);
      b += calcY(degree);
      degree+=180;
    }
    else{
      a -= calcX(degree);
      b -= calcY(degree);
      degree += 90;
    }
  }
  c = sqrt(a * a + b * b); 
  
  //find the fastest way to get there and set move
  if(fabs(currentD-degree) <= 180){
    if(currentD-degree < 0){
      degree = degree-currentD+180;
    }
    else {
       degree = degree+180;
    }
  }
  else {
    degree = currentD - degree; 
  }
  trn(degree);
  move(c);
}

void cordMove(double x, double y,int z){
  //solve c and distance of movement
  double a = fabs(currentX-x);
  double b = fabs(currentY-y);
  double c = sqrt(a * a + b * b);

  double degree = acos((b*b-a*a-c*c)/(-2*a*c));

  //find the quandrient and direction where it needs to go
  if(currentX-x > 0){
    if(currentY-y > 0){
      a += calcX(degree);
      b += calcY(degree);
      degree += 0;
    }
    else{
      a += calcX(degree);
      b -= calcY(degree);
      degree += 270;
    }

  }
  else{
    if(currentY-y > 0){
      a -= calcX(degree);
      b += calcY(degree);
      degree+=180;
    }
    else{
      a -= calcX(degree);
      b -= calcY(degree);
      degree += 90;
    }
  }
  c = sqrt(a * a + b * b); 
  
  //find the fastest way to get there and set move
  if(fabs(currentD-degree) <= 180){
    if(currentD-degree < 0){
      degree = degree-currentD+180;
    }
    else {
       degree = degree+180;
    }
  }
  else {
    degree = currentD - degree; 
  }
  trn(degree*-1);
  move(c*-1);
}

void intakeStart(){
  Intake.spin(forward);
}
 
void intakeStop(){
  Intake.stop();
}

int chainHeigth = 0;
int chainCurrent = 0;
void ChainNextCup(){
  chainHeigth+=1;
  Chain.spinFor(forward,1,turns);
} 

void ChainReturn(){
  Chain.spinFor(forward,chainHeigth,turns);
} 

void ChainBottom(){
  Chain.spinFor(reverse,chainHeigth,turns);
} 

void ChainNextCup(int x){
  chainHeigth+=1;
  Chain.spinFor(forward,1,turns,false);
} 

void ChainReturn(int x){
  Chain.spinFor(forward,chainHeigth,turns,false);
} 

void ChainBottom(int x){
  Chain.spinFor(reverse,chainHeigth,turns,false);
} 




int main() {
  // Initializing Robot Configuration. DO NOT REMOVE! 
  vexcodeInit();
  // Begin project code
  //flip the switch twice
  cordMove(72,16,0);
  cordMove(72,9.6);
  cordMove(72,16,0);
  cordMove(72,9.6);
  cordMove(72,16,0);

  //move to the input a pin
  ChainNextCup(); 
  cordMove(48,24);
  claw.set(false);
  //gather two cups
  //gather pin one
  ChainBottom(1);
  cordMove(54,24,0);
  intakeStart();
  cordMove(48,48);
  claw.set(true);
  ChainReturn(1);
  cordMove(48,24);
  intakeStop();
  ChainNextCup();
  claw.set(false);


  



  //cordMove(20.5)
  //44
  //20.25
}
