// Include the V5 Library
#include "vex.h"
  
// Allows for easier use of the VEX Library
using namespace vex;

double currentX = 70.6; 
double currentY = 8; //16 start //19 after
double currentD = 0;
double tempCurrentD=0;

double calcX(double degree){
  return 9.5*sin(degree);
}
 
double calcY(double degree){
  return 9.5*cos(degree);
}

void move(double x){
  Drivetrain.driveFor(forward, 200, inches,true);
}
void move(double x, int y){
  Drivetrain.driveFor(forward, 200, inches,false);
}

void trn(double x){
  Drivetrain.turnFor(left, x,degrees,true);
}

void trn(double x,int y){
  Drivetrain.turnFor(left, x,degrees,false);
}

void turnTo(double x){
  double degree = currentD - x;
  if(fabs(degree)-180>0){
    if(degree < 0){
      degree+=180;
    }
    else {
      degree-=180;
    }
  }
  trn(degree);
}

void turnTo(double x,int y){
  double degree = currentD - x;
  if(fabs(degree)-180>0){
    if(degree < 0){
      degree+=180;
    }
    else {
      degree-=180;
    }
  }
  trn(degree);
}


void cordMove(double x, double y){
  //solve c and distance of movement
  double a = fabs(currentX-x);
  double b = fabs(currentY-y);
  double c = sqrt(a * a + b * b);

  double degree = acos((b*b-a*a-c*c)/(-2*a*c));

  //recalculate x and y based on where the middle of the robot is
  a = fabs(currentX-(x-calcX(degree)));
  b = fabs(currentY-(y-calcY(degree)));
  c = sqrt(a * a + b * b);

  //find the quandrient and direction where it needs to go
  if(currentX-x > 0){
    if(currentY-y > 0){
      degree += 0;
    }
    degree += 270;
  }
  if(currentX-x < 0){
    if(currentY-y > 0){
      degree += 0;
    }
    else{
      degree += 270;
    }
  }
  else{
    if(currentY-y > 0){
      degree+=180;
    }
    else{
      degree += 90;
    }
    
  }
  
  //find the fastest way to get there and set move
  if(fabs(currentD-degree) <= 180){
    if(currentD-degree < 0){
      degree = degree-currentD+180;
    }
    else {
       degree = degree+180;
    }
  }
  else {
    degree = currentD - degree; 
  }
  trn(degree);
  move(c);
}

void cordMove(double x, double y,int z){//move backwards
  //solve c and distance of movement
  double a = fabs(currentX-x);
  double b = fabs(currentY-y);
  double c = sqrt(a * a + b * b);

  double degree = acos((b*b-a*a-c*c)/(-2*a*c));

  //find the quandrient and direction where it needs to go
  if(currentX-x > 0){
    if(currentY-y > 0){
      degree += 0;
    }
    degree += 270;
  }
  if(currentX-x < 0){
    if(currentY-y > 0){
      degree += 0;
    }
    else{
      degree += 270;
    }
  }
  else{
    if(currentY-y > 0){
      degree+=180;
    }
    else{
      degree += 90;
    }
    
  }
  
  tempCurrentD=degree;
  if(fabs(degree)-180>0){
    if(degree < 0){
      degree+=180;
    }
    else {
      degree-=180;
    }
  }

  currentD = tempCurrentD;
  trn(-1*degree);
  move(-1*c);
}



int main() {
  // Initializing Robot Configuration. DO NOT REMOVE!
  vexcodeInit();
  // Begin project code
  //flip the switch twice
  cordMove(72,16,0);
  cordMove(72,9.6);
  cordMove(72,16,0);
  cordMove(72,9.6);
  cordMove(72,16,0);


  //cordMove(20.5)
  //44
  //20.25
}
